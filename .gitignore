# =============================================================================
#  SagePTE artifact — files that are generated, huge, or machine-specific.
#
#  Rule of thumb: this repository holds the *tooling*. Traces, page-table dumps
#  and simulator logs are produced by running it and are far too large to
#  version — a single Redis trace is ~19 GB, and decoding one yields ~135 GB.
# =============================================================================

# --- captured inputs ----------------------------------------------------------
# Memory traces and page-table dumps, re-created by Tracer/run.sh and
# PageTables/*/run.sh.
Data/

# --- results ------------------------------------------------------------------
# Everything under Results/ is produced by a run — logs run to hundreds of
# megabytes and the analyses are regenerated with the workload.
Results/

# Per-component build logs written by build.sh.
Logs/

# --- build output -------------------------------------------------------------
build/
*.o
*.a
# ...but drsyms links against prebuilt libelftc archives that DynamoRIO ships
# in-tree rather than building; without them the tracer build dies at
# ext/drsyms with "No rule to make target .../libdwarf.a". Only the x86-64 set
# is kept: this artifact builds 64-bit Linux only, and run_arm.sh selects ARM
# cache parameters for the simulator, not an ARM build. Widen these two lines
# to libelftc*/lib*/ if a cross-arch build is ever needed.
!Tracer/ext/drsyms/libelftc/lib64/*.a
!Simulator/ext/drsyms/libelftc/lib64/*.a
*.so
*.so.*
*.ko
*.mod
*.mod.c
*.lo
*.la
.libs/
modules.order
Module.symvers
.tmp_versions/
.*.cmd

# Compiled benchmark binaries; rebuilt with `make` in Workloads/.
Workloads/bin/**
!Workloads/bin/.gitkeep

# Built on demand by PageTables/Host/run.sh.
PageTables/Host/host_pt_augmentor

# --- run-time scratch ---------------------------------------------------------
*.log
# ...but not the module table of the smoke-test trace: a raw drmemtrace
# directory cannot be replayed without the modules.log that pairs with its .raw.
!Simulator/example/**/modules.log
Tracer/enabler.txt

# Core dumps. The trailing slashes below matter: a bare `core` matches a path
# component of that name at *any* depth, which silently swallows DynamoRIO's
# core/ source tree in both Tracer/ and Simulator/. Re-including them as
# directories keeps the dumps (which are plain files) ignored.
core
core.*
!Tracer/core/
!Simulator/core/

# --- editor / OS --------------------------------------------------------------
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Decoded traces are regenerated by the simulator (or convert_trace.sh) on
# first use; only the raw capture is version-controlled.
drmemtrace.trace
